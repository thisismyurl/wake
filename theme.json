{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"_comment_architecture": "[CORE structure] The top-level keys, the settings shape, and the templateParts/customTemplates skeleton are the portable scaffold every theme in the line keeps. [SKIN values] The palette, fontFamilies, fontSizes, spacing values, and the whole styles block are design — re-authored per theme. Wake's skin is a marina/marine-services identity: deep harbor teal, one working blue accent, and two functional status colours for the slip-status board (the theme's signature feature — see patterns/slip-status-board.php). The CLI does not auto-merge this file; `colophon doctor` reports drift in the core-owned settings keys instead.",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"_comment": "[SKIN] Twelve tokens, the doctrine ceiling. Three ink steps for light-ground text, one harbor dark for bands/footer, one blue accent (tide) used on under 5% of any surface, two light tints (tide-soft, paper-soft), one hairline, one muted-on-dark (fog), one paper, and two FUNCTIONAL (not brand) status colours for the slip board: status-open (green, 'available' — the nautical starboard convention) and status-hold ('reserved/occupied'). Every text/background pairing here clears WCAG 2.2 AA at 4.5:1 or better — verified pair by pair, not eyeballed. defaultPalette off so the editor offers only Wake's tokens.",
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "ink",         "color": "#10201f", "name": "Ink" },
				{ "slug": "ink-soft",    "color": "#3a4d4f", "name": "Ink Soft" },
				{ "slug": "ink-muted",   "color": "#647476", "name": "Ink Muted" },
				{ "slug": "harbor",      "color": "#0b2e36", "name": "Harbor" },
				{ "slug": "tide",        "color": "#1d6fc4", "name": "Tide" },
				{ "slug": "tide-soft",   "color": "#e8f1fb", "name": "Tide Soft" },
				{ "slug": "line",        "color": "#dbe2e4", "name": "Hairline" },
				{ "slug": "fog",         "color": "#a9bdc0", "name": "Fog" },
				{ "slug": "paper",       "color": "#fbfbf9", "name": "Paper" },
				{ "slug": "paper-soft",  "color": "#eef2f3", "name": "Paper Soft" },
				{ "slug": "status-open", "color": "#146346", "name": "Status: Open" },
				{ "slug": "status-hold", "color": "#a5591c", "name": "Status: Hold" }
			],
			"gradients": [
				{
					"slug": "harbor-dusk",
					"gradient": "linear-gradient(165deg, rgba(11,46,54,0.28) 0%, rgba(6,15,18,0.94) 68%)",
					"name": "Harbor Dusk (hero overlay)"
				},
				{
					"slug": "tide-flow",
					"gradient": "linear-gradient(135deg, #1d6fc4 0%, #3f93e8 100%)",
					"name": "Tide Flow (button)"
				}
			]
		},
		"typography": {
			"_comment": "[SKIN] DM Sans (display/headings/UI, geometric, self-hosted variable wght 400-800) paired with IBM Plex Sans (body copy — a technical, instrument-panel humanist sans that reads right for a marina's operational content: rates, hours, slip specs). Both SIL OFL 1.1. System stacks are the fallback chain, never the primary.",
			"fluid": true,
			"customFontSize": false,
			"defaultFontSizes": false,
			"lineHeight": true,
			"letterSpacing": true,
			"textTransform": true,
			"textDecoration": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"name": "DM Sans",
					"slug": "dm-sans",
					"fontFamily": "'DM Sans', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontWeight": "400 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/dm-sans/dm-sans-variable-latin-ext.woff2", "file:./assets/fonts/dm-sans/dm-sans-variable-latin.woff2" ]
						}
					]
				},
				{
					"name": "IBM Plex Sans",
					"slug": "ibm-plex-sans",
					"fontFamily": "'IBM Plex Sans', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Sans",
							"fontWeight": "400 600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans/plex-sans-normal-latin-ext.woff2", "file:./assets/fonts/ibm-plex-sans/plex-sans-normal-latin.woff2" ]
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontWeight": "400",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans/plex-sans-italic-latin-ext.woff2", "file:./assets/fonts/ibm-plex-sans/plex-sans-italic-latin.woff2" ]
						}
					]
				},
				{
					"name": "Serif",
					"slug": "serif",
					"fontFamily": "Georgia, 'Times New Roman', Times, serif"
				},
				{
					"name": "Sans",
					"slug": "sans",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"name": "Mono",
					"slug": "mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "name": "X-Small",  "slug": "xs",      "size": "0.75rem",                                                                    "fluid": false },
				{ "name": "Small",    "slug": "sm",      "size": "clamp(0.875rem, 0.85rem + 0.12vw, 0.9375rem)",  "fluid": { "min": "0.875rem",  "max": "0.9375rem" } },
				{ "name": "Base",     "slug": "base",    "size": "clamp(1.0625rem, 1rem + 0.25vw, 1.125rem)",      "fluid": { "min": "1.0625rem", "max": "1.125rem" } },
				{ "name": "Medium",   "slug": "md",      "size": "clamp(1.2rem, 1.1rem + 0.4vw, 1.45rem)",         "fluid": { "min": "1.2rem",    "max": "1.45rem" } },
				{ "name": "Large",    "slug": "lg",      "size": "clamp(1.5rem, 1.3rem + 0.9vw, 2rem)",            "fluid": { "min": "1.5rem",    "max": "2rem" } },
				{ "name": "X-Large",  "slug": "xl",      "size": "clamp(2rem, 1.6rem + 1.8vw, 3rem)",              "fluid": { "min": "2rem",      "max": "3rem" } },
				{ "name": "2X-Large", "slug": "2xl",     "size": "clamp(2.5rem, 1.9rem + 3vw, 4.5rem)",            "fluid": { "min": "2.5rem",    "max": "4.5rem" } },
				{ "name": "3X-Large", "slug": "3xl",     "size": "clamp(3rem, 2.2rem + 4vw, 5rem)",                "fluid": { "min": "3rem",      "max": "5rem" } },
				{ "name": "Display",  "slug": "display", "size": "clamp(3rem, 1.8rem + 6vw, 6.5rem)",              "fluid": { "min": "3rem",      "max": "6.5rem" } }
			]
		},
		"spacing": {
			"_comment": "[CORE structure / SKIN values] A linear step scale, unchanged from Colophon core — Wake's section rhythm uses these as-is.",
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "1",  "slug": "1",  "size": "0.25rem" },
				{ "name": "2",  "slug": "2",  "size": "0.5rem" },
				{ "name": "3",  "slug": "3",  "size": "0.75rem" },
				{ "name": "4",  "slug": "4",  "size": "1rem" },
				{ "name": "5",  "slug": "5",  "size": "1.5rem" },
				{ "name": "6",  "slug": "6",  "size": "2rem" },
				{ "name": "8",  "slug": "8",  "size": "2.5rem" },
				{ "name": "10", "slug": "10", "size": "3rem" },
				{ "name": "12", "slug": "12", "size": "4rem" },
				{ "name": "16", "slug": "16", "size": "6rem" },
				{ "name": "20", "slug": "20", "size": "8rem" }
			]
		},
		"layout": {
			"_comment": "[CORE structure / SKIN values] contentSize = reading measure; wideSize = the band width. Full-bleed hero/CTA patterns use align:full and ignore both.",
			"contentSize": "720px",
			"wideSize": "1140px"
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"dimensions": { "minHeight": true, "aspectRatio": true },
		"position": { "sticky": true },
		"blocks": {
			"core/button": { "border": { "radius": true } },
			"core/post-featured-image": { "allowResize": false }
		}
	},
	"styles": {
		"_comment": "[SKIN] Marina/marine-services design. DM Sans for headings and UI, IBM Plex Sans for reading and data. Harbor-dark bands, one working blue, real WCAG-checked contrast throughout.",
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--6)",
			"padding": {
				"left": "var(--wp--preset--spacing--5)",
				"right": "var(--wp--preset--spacing--5)"
			}
		},
		"elements": {
			"h1": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "var(--wp--preset--font-size--2-xl)", "fontWeight": "800", "lineHeight": "1.05", "letterSpacing": "-0.02em", "fontStyle": "normal" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h2": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "var(--wp--preset--font-size--xl)", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.015em", "fontStyle": "normal" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h3": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "var(--wp--preset--font-size--lg)", "fontWeight": "700", "lineHeight": "1.25", "letterSpacing": "-0.01em", "fontStyle": "normal" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h4": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "var(--wp--preset--font-size--md)", "fontWeight": "700", "lineHeight": "1.3", "fontStyle": "normal" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h5": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "var(--wp--preset--font-size--sm)", "fontWeight": "700", "lineHeight": "1.4", "letterSpacing": "0.06em", "textTransform": "uppercase", "fontStyle": "normal" },
				"color": { "text": "var(--wp--preset--color--ink-soft)" }
			},
			"h6": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "var(--wp--preset--font-size--xs)", "fontWeight": "700", "lineHeight": "1.5", "letterSpacing": "0.08em", "textTransform": "uppercase", "fontStyle": "normal" },
				"color": { "text": "var(--wp--preset--color--ink-muted)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--tide)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--ink)" } },
				":focus": { "color": { "text": "var(--wp--preset--color--ink)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--tide)", "text": "var(--wp--preset--color--paper)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "var(--wp--preset--font-size--sm)", "fontWeight": "700", "letterSpacing": "0.01em" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "var(--wp--preset--spacing--3)", "bottom": "var(--wp--preset--spacing--3)", "left": "var(--wp--preset--spacing--6)", "right": "var(--wp--preset--spacing--6)" } },
				":hover": { "color": { "background": "#1a5fa8", "text": "var(--wp--preset--color--paper)" } },
				":focus": { "color": { "background": "#1a5fa8", "text": "var(--wp--preset--color--paper)" } }
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.65" }
			},
			"core/pullquote": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "var(--wp--preset--font-size--lg)", "fontWeight": "700", "lineHeight": "1.3" },
				"color": { "text": "var(--wp--preset--color--ink)", "background": "transparent" }
			},
			"core/quote": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)", "fontSize": "var(--wp--preset--font-size--md)", "fontStyle": "italic", "lineHeight": "1.55" },
				"color": { "text": "var(--wp--preset--color--ink-soft)" },
				"spacing": { "padding": { "left": "var(--wp--preset--spacing--5)" } }
			},
			"core/code": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--sm)", "lineHeight": "1.6" },
				"color": { "background": "var(--wp--preset--color--paper-soft)", "text": "var(--wp--preset--color--ink)" }
			},
			"core/post-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontWeight": "800", "lineHeight": "1.08", "letterSpacing": "-0.02em", "textDecoration": "none" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"core/post-excerpt": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.6" },
				"color": { "text": "var(--wp--preset--color--ink-soft)" }
			},
			"core/post-date": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)", "fontSize": "var(--wp--preset--font-size--sm)" },
				"color": { "text": "var(--wp--preset--color--ink-muted)" }
			},
			"core/post-terms": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "var(--wp--preset--font-size--xs)", "fontWeight": "700", "letterSpacing": "0.08em", "textTransform": "uppercase" },
				"color": { "text": "var(--wp--preset--color--tide)" }
			},
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "var(--wp--preset--font-size--lg)", "fontWeight": "800", "letterSpacing": "-0.01em", "textDecoration": "none" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"core/site-tagline": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--ibm-plex-sans)", "fontSize": "var(--wp--preset--font-size--sm)", "letterSpacing": "0.04em" },
				"color": { "text": "var(--wp--preset--color--ink-muted)" }
			},
			"core/navigation": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "var(--wp--preset--font-size--sm)", "fontWeight": "600", "letterSpacing": "0.01em" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": []
}
